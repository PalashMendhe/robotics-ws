<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="arm_base_link_height" value="0.02"/>
  <xacro:property name="arm_base_link_radius" value="0.05"/>
  <xacro:property name="arm_base_link_weight" value="0.3"/>

  <!-- ==================== Inertia Macros ================ -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(3*r*r+h*h)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(3*r*r+h*h)}"
        iyz="0"
        izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== ARM BASE LINK ==================== -->
  <link name="arm_base_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="${arm_base_link_radius}" length="${arm_base_link_height}"/>
    </geometry>
    <material name="orange">
      <color rgba="0.85 0.035 0 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.05" length="0.02"/>
    </geometry>
  </collision>
  <xacro:cylinder_inertia m="${arm_base_link_weight}" r="${arm_base_link_radius}" h="${arm_base_link_height}"/>
  </link>

  <joint name="arm_base_joint" type="revolute">
    <parent link="arm_mount"/>
    <child link="arm_base_link"/>
    <origin xyz="0.0 0 0.0325" rpy="0 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ==================== FOREARM LINK ==================== -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 1.5707 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.13"/>
      </geometry>
      <material name="green">
        <color rgba="0.035 0.85 0.035 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 1.5707 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.13"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.022" h="0.13"/>
  </link>

  <joint name="forearm_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== UPPER ARM LINK ==================== -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.085" rpy="0 1.5707 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.17"/>
      </geometry>
      <material name="blue">
        <color rgba="0.035 0.035 0.85 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.085" rpy="0 1.5707 0"/>
      <geometry>
      <cylinder radius="0.025" length="0.17"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.4" r="0.025" h="0.17"/>

  </link>

  <joint name="upper_arm_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    <axis xyz="0 1 0"/>
  </joint>

  

</robot>