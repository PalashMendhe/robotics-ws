<?xml version="1.0"?>
<sdf version="1.8">
  <model name="aruco_marker_3">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <!-- 0.15 m marker panel, 2 mm thick, thin in Y (facing ±Y by default) -->
          <box>
            <size>0.15 0.002 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_marker_3/materials/textures/aruco_3.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.002 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
