    <!-- ================================================================= -->
    <!-- ROBOTIC ARM 1 (Mounted on Shelf 1 at z=0.4m)                       -->
    <!-- Reach: Link1=0.20m, Link2=0.20m, Link3=0.10m                      -->
    <!-- ================================================================= -->
    <model name="arm_1">
      <static>true</static>
      <pose>0.3 0.3 0.4 0 0 0</pose>
      <link name="arm_base">
        <!-- Base Pedestal -->
        <visual name="visual_base">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Base Turret -->
        <visual name="visual_turret">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Link 1 (Upper Arm, Length = 0.20m) -->
