          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
          </material>
        </visual>
        <!-- Joint 1 Knuckle / Housing -->
        <visual name="visual_joint1_cyl">
          <pose>0 0 0.26 1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="visual_joint1_sph">
          <pose>0 0 0.26 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.036</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Link 2 (Forearm, Length = 0.20m, tilted 35 deg forward) -->
        <visual name="visual_link2">
          <pose>0.057358 0 0.341915 0 0.610865 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
          </material>
        </visual>
        <!-- Joint 2 Knuckle / Housing -->
        <visual name="visual_joint2_cyl">
          <pose>0.114715 0 0.423830 1.570796 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.030</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="visual_joint2_sph">
