          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- BOX 1 (Spawned on Shelf 1, 0.15m x 0.15m x 0.12m, mass: 0.5kg)    -->
    <!-- 0.1m lateral from arm base on shelf surface (z = 0.46m)           -->
    <!-- ================================================================= -->
    <model name="box_1">
      <pose>0.3 0.3 0.46 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0015375</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0015375</iyy>
