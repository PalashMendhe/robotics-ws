    <!-- ================================================================= -->
    <!-- ROOM 1 POSITIONS: BASE STATION & DESTINATION                      -->
    <!-- Base Station: x=1.5, y=1.5 from Room 1 origin (-0.5, 3.7) -> (1.0, 5.2) -->
    <!-- Destination : x=2.5, y=2.5 from Room 1 origin (-0.5, 3.7) -> (2.0, 6.2) -->
    <!-- ================================================================= -->

    <!-- Base Station Docking Pad -->
    <model name="base_station">
      <static>true</static>
      <pose>1.0 5.2 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad_outer">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.8 1</ambient>
            <diffuse>0.15 0.5 0.95 1</diffuse>
          </material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Destination Dropoff Zone -->
    <model name="destination_station">
      <static>true</static>
      <pose>2.0 6.2 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad_outer">
          <geometry>
            <box>
              <size>0.8 0.8 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.3 1</ambient>
            <diffuse>0.15 0.85 0.35 1</diffuse>
          </material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
