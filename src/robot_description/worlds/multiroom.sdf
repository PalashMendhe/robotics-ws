          <geometry>
            <sphere>
              <radius>0.031</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Link 3 (Wrist Shaft, Length = 0.10m, tilted down 110 deg) -->
        <visual name="visual_link3">
          <pose>0.161700 0 0.406729 0 1.919862 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
          </material>
        </visual>
        <!-- End Effector Flange Adapter -->
        <visual name="visual_suction_flange">
          <pose>0.215732 0 0.387063 0 1.919862 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- End Effector Suction Cup / Bellow -->
        <visual name="visual_suction_gripper">
          <pose>0.229827 0 0.381933 0 1.919862 0</pose>
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
