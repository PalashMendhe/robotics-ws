    <!-- aruco_detector_node's marker_size param in sync (0.1125).           -->
    <!--                                                                     -->
    <!-- ID 0 — Room 2 south APPROACH wall (front camera detects)           -->
    <!--         Shelf 1 is at y=0.3; robot enters from y>0 direction       -->
    <!--         Panel on south wall (y≈-0.1), facing +Y toward robot       -->
    <!-- ID 1 — Shelf 1 DOCK marker (rear camera detects while reversing)   -->
    <!--         On the +Y face of shelf_1 (y=0.5); robot backs from +Y     -->
    <!-- ID 2 — Room 3 west APPROACH wall (front camera detects)            -->
    <!--         Shelf 2 is at x=6.65; robot enters Room 3 from x<3.6      -->
    <!--         Panel on west wall (x≈3.6 doorway side), facing +X         -->
    <!-- ID 3 — Shelf 2 DOCK marker (rear camera detects while reversing)   -->
    <!--         On the -Y face of shelf_2 (y=5.6); robot backs from -Y    -->
    <!-- ================================================================= -->
 
    <!-- aruco_1: Shelf 1 DOCK marker (ID 0, rear camera detects while
         reversing). Actual pose (0.025, 0.7431, 0.13), yaw=1.5707: a free-
         standing panel north-west of shelf_1, face normal +X — the bot
         aligns at yaw=0 and backs up so its rear camera (-X) sees it.
         NOTE: NOT flush on shelf_1's +Y face despite older comments.
         docking_node default pre-dock waypoint: (0.7, 0.7431, yaw=0). -->
    <model name="aruco_dock_shelf1">
