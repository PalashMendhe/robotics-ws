    <model name="red_box_1">
      <static>true</static>
      <pose>1.9 0 0.33 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.12 0.12</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="green_cylinder_1">
      <static>true</static>
      <pose>1.9 -0.7 0.07 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
