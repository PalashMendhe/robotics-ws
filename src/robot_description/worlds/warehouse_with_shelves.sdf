              <size>0.1 2 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_left_side">
      <static>true</static>
      <pose>1.9 0.95 0.35 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
