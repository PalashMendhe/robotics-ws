    </model>

    <model name="shelf_1">
      <static>true</static>
      <pose>1.9 0 0.25 0 1.57 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 2 0.2</size>
