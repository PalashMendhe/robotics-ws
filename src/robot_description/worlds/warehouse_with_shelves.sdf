    </model>

    <model name="shelf_upper">
      <static>true</static>
      <pose>1.9 0 0.67 0 1.57 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 2 0.2</size>
