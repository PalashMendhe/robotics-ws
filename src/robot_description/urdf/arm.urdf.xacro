<?xml version="1.0"?>
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================= -->
  <!-- ARM SPECIFICATIONS & PROPERTIES                                   -->
  <!-- ================================================================= -->
  <!-- Mount Height: Arm base mounted on shelf surface (z = 0.4m)        -->
  <xacro:property name="mount_height"   value="0.40"/>

  <!-- Link Lengths: Total Reach = 0.20 + 0.20 + 0.10 = 0.50m           -->
  <xacro:property name="link1_length"   value="0.20"/>
  <xacro:property name="link2_length"   value="0.20"/>
  <xacro:property name="link3_length"   value="0.10"/>
  <xacro:property name="total_reach"    value="0.50"/>

  <!-- Radii and Dimensions -->
  <xacro:property name="base_radius"    value="0.06"/>
  <xacro:property name="base_height"    value="0.04"/>
  <xacro:property name="link1_radius"   value="0.03"/>
  <xacro:property name="link2_radius"   value="0.025"/>
  <xacro:property name="link3_radius"   value="0.02"/>
  <xacro:property name="gripper_radius" value="0.03"/>
  <xacro:property name="gripper_height" value="0.02"/>

  <!-- Masses (kg) -->
  <xacro:property name="base_mass"      value="0.8"/>
  <xacro:property name="link1_mass"     value="0.5"/>
  <xacro:property name="link2_mass"     value="0.4"/>
  <xacro:property name="link3_mass"     value="0.2"/>
  <xacro:property name="gripper_mass"   value="0.1"/>

  <!-- ================================================================= -->
  <!-- INERTIAL MACROS                                                   -->
  <!-- ================================================================= -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(3*r*r + h*h)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(3*r*r + h*h)}"
        iyz="0"
        izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(y*y + z*z)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(x*x + z*z)}"
        iyz="0"
        izz="${(1/12)*m*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================= -->
  <!-- MATERIALS                                                         -->
  <!-- ================================================================= -->
  <material name="industrial_orange">
    <color rgba="0.95 0.45 0.05 1.0"/>
  </material>

  <material name="dark_metallic">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="joint_grey">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="suction_cup_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- ================================================================= -->
  <!-- WORLD / MOUNT ATTACHMENT                                          -->
  <!-- ================================================================= -->
  <link name="world"/>

  <joint name="world_to_arm_mount" type="fixed">
    <parent link="world"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 ${mount_height}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================= -->
  <!-- ARM BASE LINK (Pedestal mounted at z = 0.4m)                      -->
  <!-- ================================================================= -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="dark_metallic"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"/>
  </link>

  <!-- ================================================================= -->
  <!-- JOINT 1: Shoulder Pan (Yaw - Rotation around Z)                   -->
  <!-- ================================================================= -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ================================================================= -->
  <!-- LINK 1: Shoulder / Upper Arm (Length = 0.20m)                     -->
  <!-- ================================================================= -->
  <link name="arm_link_1">
    <!-- Shoulder Pan Turret Base -->
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius * 0.75}" length="0.02"/>
      </geometry>
      <material name="dark_metallic"/>
    </visual>
    <!-- Main Upper Arm Cylinder -->
    <visual>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <!-- Shoulder Joint Visual Housing -->
    <visual>
      <origin xyz="0 0 ${link1_length}" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius * 1.15}" length="${link1_radius * 2.2}"/>
      </geometry>
      <material name="joint_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${link1_mass}" r="${link1_radius}" h="${link1_length}"/>
  </link>

  <!-- ================================================================= -->
  <!-- JOINT 2: Shoulder Pitch (Rotation around Y)                       -->
  <!-- ================================================================= -->
  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- ================================================================= -->
  <!-- LINK 2: Forearm (Length = 0.20m)                                  -->
  <!-- ================================================================= -->
  <link name="arm_link_2">
    <!-- Main Forearm Cylinder -->
    <visual>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <!-- Elbow Joint Visual Housing -->
    <visual>
      <origin xyz="0 0 ${link2_length}" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="${link2_radius * 1.15}" length="${link2_radius * 2.2}"/>
      </geometry>
      <material name="joint_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${link2_mass}" r="${link2_radius}" h="${link2_length}"/>
  </link>

  <!-- ================================================================= -->
  <!-- JOINT 3: Wrist Pitch / Elbow (Rotation around Y)                  -->
  <!-- ================================================================= -->
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="10.0" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- ================================================================= -->
  <!-- LINK 3: Wrist / End Effector Mount (Length = 0.10m)               -->
  <!-- ================================================================= -->
  <link name="arm_link_3">
    <!-- Wrist Shaft -->
    <visual>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${link3_mass}" r="${link3_radius}" h="${link3_length}"/>
  </link>

  <!-- ================================================================= -->
  <!-- JOINT 4: End Effector Mount (Fixed)                               -->
  <!-- ================================================================= -->
  <joint name="end_effector_mount_joint" type="fixed">
    <parent link="arm_link_3"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================= -->
  <!-- END EFFECTOR LINK: Suction Cup / Vacuum Gripper                   -->
  <!-- ================================================================= -->
  <link name="end_effector_link">
    <!-- Flange adapter -->
    <visual>
      <origin xyz="0 0 ${gripper_height/4}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${gripper_radius * 0.7}" length="${gripper_height/2}"/>
      </geometry>
      <material name="dark_metallic"/>
    </visual>
    <!-- Suction cup bellow pad -->
    <visual>
      <origin xyz="0 0 ${gripper_height * 0.75}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${gripper_radius}" length="${gripper_height/2}"/>
      </geometry>
      <material name="suction_cup_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${gripper_radius}" length="${gripper_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${gripper_mass}" r="${gripper_radius}" h="${gripper_height}"/>
  </link>

  <!-- Tool Center Point (TCP) frame for navigation / manipulation IK -->
  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 ${gripper_height}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================= -->
  <!-- GAZEBO COLORS & PLUGINS                                           -->
  <!-- ================================================================= -->
  <gazebo reference="arm_base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="arm_link_1">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="arm_link_2">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="arm_link_3">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="end_effector_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Path to arm_controllers.yaml — set by launch file via xacro:arg -->
  <xacro:arg name="controllers_file" default=""/>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>arm_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
      

<ros2_control name="arm_gz_system" type="system">
  <hardware>
    <plugin>mock_components/GenericSystem</plugin>
  </hardware>
  <joint name="shoulder_pan_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="shoulder_pitch_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="wrist_pitch_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

</robot>
