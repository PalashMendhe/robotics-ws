<?xml version="1.0"?>
<robot name="differential_drive_robot" 
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="base_length" value="0.35"/>
  <xacro:property name="base_width"  value="0.25"/>
  <xacro:property name="base_height" value="0.07"/>
  <xacro:property name="base_mass"   value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.1"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_mass"   value="0.2"/>

  <!-- ==================== INERTIA MACROS ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(y*y+z*z)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(x*x+z*z)}"
        iyz="0"
        izz="${(1/12)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(3*r*r+h*h)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(3*r*r+h*h)}"
        iyz="0"
        izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(2/5)*m*r*r}"
        ixy="0" ixz="0"
        iyy="${(2/5)*m*r*r}"
        iyz="0"
        izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== WHEEL MACRO ==================== -->
  <xacro:macro name="wheel" params="name x_offset y_offset">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" 
                              r="${wheel_radius}" 
                              h="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} -0.035" rpy="-1.5707 0 0"/>
      <limit lower="-1e+16" upper="1e+16" effort="10" velocity="10"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}"
                       y="${base_width}"
                       z="${base_height}"/>
  </link>
  <!-- ==================== Cover_plate ==================== -->
  <link name="cover_plate">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.35 0.30 0.01"/>
    </geometry>
    <material name="dark_grey">
      <color rgba="0.2 0.2 0.2 1"/>
    </material>
  </visual>
  <xacro:box_inertia m="0.3" x="0.35" y="0.30" z="0.01"/>
</link>

<joint name="cover_plate_joint" type="fixed">
  <parent link="base_link"/>
  <child link="cover_plate"/>
  <origin xyz="0 0 0.040" rpy="0 0 0"/>
</joint>




  <!-- ==================== WHEELS ==================== -->
  <xacro:wheel name="front_left" x_offset="0.12" y_offset="0.14"/>
  <xacro:wheel name="front_right" x_offset="0.12" y_offset="-0.14"/>
  <xacro:wheel name="rear_left"   x_offset="-0.12" y_offset="0.14"/>
  <xacro:wheel name="rear_right"  x_offset="-0.12" y_offset="-0.14"/>

  <!-- ==================== LIDAR ==================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" 
                            r="${lidar_radius}" 
                            h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- On top of base, centered -->
    <origin xyz="0.0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CAMERA ==================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Front of robot, tilted down 30 degrees -->
    <origin xyz="0.175 0 0.04" rpy="0 -0.523 0"/>
  </joint>

<gazebo>
	<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
		<left_joint>front_left_wheel_joint</left_joint>
		<right_joint>front_right_wheel_joint</right_joint>
		<wheel_separation>0.28</wheel_separation>
		<wheel_radius>0.05</wheel_radius>
		<odom_publish_frequency>10</odom_publish_frequency>
		<topic>/model/my_robot/cmd_vel</topic>
		<odom_topic>/model/my_robot/odometry</odom_topic>
		<frame_id>odom</frame_id>
		<child_frame_id>base_link</child_frame_id>
	</plugin>
</gazebo>

<gazebo reference="lidar_link">
  <sensor name="lidar" type="lidar">
    <topic>/scan</topic>
    <update_rate>10</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="base_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <topic>/imu</topic>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <topic>/camera/image_raw</topic>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>
<!-- <xacro:include filename="$(find arm_description)/urdf/arm.urdf.xacro"/> -->

</robot>
