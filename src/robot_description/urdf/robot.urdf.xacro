<?xml version="1.0"?>
<robot name="differential_drive_robot" 
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="base_length" value="0.35"/>
  <xacro:property name="base_width"  value="0.25"/>
  <xacro:property name="base_height" value="0.07"/>
  <xacro:property name="base_mass"   value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.1"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_mass"   value="0.2"/>

  <!-- Standoffs: 4 cylinders at cover_plate corners holding up standoff_floor -->
  <xacro:property name="standoff_height" value="0.052"/>
  <xacro:property name="standoff_radius" value="0.01"/>
  <xacro:property name="standoff_mass"   value="0.075"/>

  <!-- Standoff floor: same footprint as base, thin plate above standoffs -->
  <xacro:property name="standoff_floor_length" value="0.35"/>
  <xacro:property name="standoff_floor_width"  value="0.25"/>
  <xacro:property name="standoff_floor_height" value="0.01"/>
  <xacro:property name="standoff_floor_mass"   value="0.3"/>

  <!-- Cover plate sits on top of base_link.
       cover_plate top surface  = base_height/2 + cover_plate_joint_z + plate_half_h
                                = 0.035 + 0.040 + 0.005 = 0.080 above base center
       Shortcuts for pose calculations (all relative to base_link centre):
         cover_top_z  = 0.040 + 0.005            = 0.045
         standoff_ctr = cover_top_z + stdh/2      = 0.045 + 0.026 = 0.071
         sfp_ctr      = cover_top_z + stdh + sfh/2= 0.045+0.052+0.005 = 0.102
  -->

  <!-- Tray walls (funnel) mounted on standoff_floor.
       Provide a 30 mm lip angled 15° outward to guide the delivery box to
       centre even if the arm drops it up to ~50 mm off-centre.
       wall_h   = 0.030  (lip height above floor top surface)
       wall_t   = 0.006  (wall thickness)
       tilt     = 15°    (0.5236 rad) outward on each wall
       Joint z  = sfp_half_h + wall_half_h = 0.005 + 0.015 = 0.020
  -->
  <xacro:property name="tray_wall_h"    value="0.045"/>
  <xacro:property name="tray_wall_t"    value="0.006"/>
  <xacro:property name="tray_wall_mass" value="0.02"/>

  <!-- ==================== INERTIA MACROS ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(y*y+z*z)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(x*x+z*z)}"
        iyz="0"
        izz="${(1/12)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(3*r*r+h*h)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(3*r*r+h*h)}"
        iyz="0"
        izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(2/5)*m*r*r}"
        ixy="0" ixz="0"
        iyy="${(2/5)*m*r*r}"
        iyz="0"
        izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== WHEEL MACRO ==================== -->
  <xacro:macro name="wheel" params="name x_offset y_offset">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" 
                              r="${wheel_radius}" 
                              h="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} -0.035" rpy="-1.5707 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.001" friction="0.0"/>
    </joint>

    <gazebo reference="${name}_wheel">
      <mu1>1.1</mu1>
      <mu2>0.05</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>100000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ==================== STANDOFF MACRO ====================
       Each standoff is a fixed cylinder connecting cover_plate to standoff_floor.
       x_offset / y_offset place it at a corner of the plate.
       Joint origin z = cover_plate_half_h + standoff_half_h
                      = 0.005 + 0.026 = 0.031
       (measured from cover_plate centre, so the bottom of the standoff
        sits flush on the cover_plate top surface)
  -->
  <xacro:macro name="standoff" params="name x_offset y_offset">
    <link name="${name}_standoff">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${standoff_radius}" length="${standoff_height}"/>
        </geometry>
        <material name="silver">
          <color rgba="0.7 0.7 0.7 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${standoff_radius}" length="${standoff_height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${standoff_mass}"
                              r="${standoff_radius}"
                              h="${standoff_height}"/>
    </link>

    <!-- Parent: cover_plate. z offset = plate_half_h + standoff_half_h -->
    <joint name="${name}_standoff_joint" type="fixed">
      <parent link="cover_plate"/>
      <child link="${name}_standoff"/>
      <origin xyz="${x_offset} ${y_offset} ${0.005 + standoff_height/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ==================== TRAY WALL MACRO ====================
       A single retention lip fixed to standoff_floor.
       params:
         name        – unique suffix (front / rear / left / right)
         wx / wy     – box dimensions in X and Y (one axis = tray_wall_t)
         x_off/y_off – wall centre relative to standoff_floor centre
         rpy         – outward tilt (15° = 0.5236 rad around relevant axis)
       z joint = sfp_half_h + wall_half_h = 0.005 + 0.015 = 0.020
  -->
  <xacro:macro name="tray_wall" params="name wx wy x_off y_off rpy">
    <link name="tray_wall_${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${wx} ${wy} ${tray_wall_h}"/>
        </geometry>
        <material name="orange_tray">
          <color rgba="1.0 0.45 0.0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${wx} ${wy} ${tray_wall_h}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${tray_wall_mass}" x="${wx}" y="${wy}" z="${tray_wall_h}"/>
    </link>
    <joint name="tray_wall_${name}_joint" type="fixed">
      <parent link="standoff_floor"/>
      <child  link="tray_wall_${name}"/>
      <!-- z: sfp_half_h + wall_half_h = 0.005 + 0.015 = 0.020 -->
      <origin xyz="${x_off} ${y_off} 0.020" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ==================== BASE FOOTPRINT ==================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}"
                       y="${base_width}"
                       z="${base_height}"/>
  </link>

  <!-- ==================== WHEELS ==================== -->
  <xacro:wheel name="front_left"  x_offset="0.12"  y_offset="0.14"/>
  <xacro:wheel name="front_right" x_offset="0.12"  y_offset="-0.14"/>
  <xacro:wheel name="rear_left"   x_offset="-0.12" y_offset="0.14"/>
  <xacro:wheel name="rear_right"  x_offset="-0.12" y_offset="-0.14"/>

  <!-- ==================== COVER PLATE ====================
       Sits directly on top of base_link.
       Joint z = base_height/2 + plate_height/2 = 0.035 + 0.005 = 0.040
       cover_plate centre is at z=0.040 relative to base_link centre.
       cover_plate top surface  = 0.040 + 0.005 = 0.045 above base_link centre.
       The LiDAR mounts here.
  -->
  <link name="cover_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.30 0.01"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.30 0.01"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.3" x="0.35" y="0.30" z="0.01"/>
  </link>

  <joint name="cover_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cover_plate"/>
    <!-- base_height/2 + cover_plate_height/2 = 0.035 + 0.005 = 0.040 -->
    <origin xyz="0 0 0.040" rpy="0 0 0"/>
  </joint>

  <!-- ==================== STANDOFFS (4 corners of cover_plate) ====================
       Corner positions: ±(base_length/2 - margin) × ±(base_width/2 - margin)
       margin = 0.025 m keeps standoffs inside the plate footprint.
       x: ±(0.35/2 - 0.025) = ±0.150
       y: ±(0.25/2 - 0.025) = ±0.100
  -->
  <xacro:standoff name="front_left"  x_offset=" 0.150" y_offset=" 0.100"/>
  <xacro:standoff name="front_right" x_offset=" 0.150" y_offset="-0.100"/>
  <xacro:standoff name="rear_left"   x_offset="-0.150" y_offset=" 0.100"/>
  <xacro:standoff name="rear_right"  x_offset="-0.150" y_offset="-0.100"/>

  <!-- ==================== STANDOFF FLOOR ====================
       Rests on top of all 4 standoffs.
       Parent: cover_plate.
       z = cover_plate_half_h + standoff_height + floor_half_h
         = 0.005 + 0.052 + 0.005 = 0.062  (from cover_plate centre)
       Which is 0.040 + 0.062 = 0.102 above base_link centre.
       The delivery_box will sit on top of this floor.
  -->
  <link name="standoff_floor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${standoff_floor_length} ${standoff_floor_width} ${standoff_floor_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${standoff_floor_length} ${standoff_floor_width} ${standoff_floor_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${standoff_floor_mass}"
                       x="${standoff_floor_length}"
                       y="${standoff_floor_width}"
                       z="${standoff_floor_height}"/>
  </link>

  <joint name="standoff_floor_joint" type="fixed">
    <parent link="cover_plate"/>
    <child link="standoff_floor"/>
    <!-- cover_plate_half_h + standoff_height + floor_half_h
         = 0.005 + 0.052 + 0.005 = 0.062 -->
    <origin xyz="0 0 0.062" rpy="0 0 0"/>
  </joint>

  <!-- ==================== TRAY WALLS (4 retention lips on standoff_floor) ====================
       standoff_floor: 0.35 m (X) × 0.25 m (Y) × 0.01 m (Z)
       Height: 0.030 m  |  Tilt: 15° outward  |  Joint z = 0.020 (sfp_half + wall_half)
       Front/rear walls span full Y width.  Left/right walls span inner X (fit between front/rear).
       Tilt rotations (right-hand rule, outward = away from tray centre):
         front (+X): pitch +0.5236   rear (−X): pitch −0.5236
         left  (+Y): roll  −0.5236   right(−Y): roll  +0.5236
  -->
  <!-- Front wall: spans full Y width, sits at +X edge, top tilts outward (+X) -->
  <xacro:tray_wall name="front"
    wx="${tray_wall_t}"
    wy="${standoff_floor_width}"
    x_off="${standoff_floor_length/2 - tray_wall_t/2}"
    y_off="0"
    rpy="0 0.5236 0"/>

  <!-- Rear wall: spans full Y width, sits at -X edge, top tilts outward (-X) -->
  <xacro:tray_wall name="rear"
    wx="${tray_wall_t}"
    wy="${standoff_floor_width}"
    x_off="${-(standoff_floor_length/2 - tray_wall_t/2)}"
    y_off="0"
    rpy="0 -0.5236 0"/>

  <!-- Left wall: inner X span, sits at +Y edge, top tilts outward (+Y) -->
  <xacro:tray_wall name="left"
    wx="${standoff_floor_length - 2*tray_wall_t}"
    wy="${tray_wall_t}"
    x_off="0"
    y_off="${standoff_floor_width/2 - tray_wall_t/2}"
    rpy="-0.5236 0 0"/>

  <!-- Right wall: inner X span, sits at -Y edge, top tilts outward (-Y) -->
  <xacro:tray_wall name="right"
    wx="${standoff_floor_length - 2*tray_wall_t}"
    wy="${tray_wall_t}"
    x_off="0"
    y_off="${-(standoff_floor_width/2 - tray_wall_t/2)}"
    rpy="0.5236 0 0"/>


  <!-- ==================== LIDAR ====================

       Mounts on top of cover_plate (centre of the plate).
       Parent: cover_plate.
       z = cover_plate_half_h + lidar_height/2 = 0.005 + 0.025 = 0.030
  -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" 
                            r="${lidar_radius}" 
                            h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="cover_plate"/>
    <child link="lidar_link"/>
    <!-- cover_plate_half_h + lidar_half_h = 0.005 + 0.025 = 0.030 -->
    <origin xyz="0.0 0 0.030" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CAMERA FRONT ====================
       Faces forward (+X), tilted down 30° to see floor/markers on approach.
       Topic: /camera/front/image_raw
  -->
  <link name="camera_link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.03"/>
  </link>

  <joint name="camera_joint_1" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link_1"/>
    <!-- Front face of robot (base_length/2=0.175), same height as cover_plate top -->
    <origin xyz="0.175 0 0.04" rpy="0 -0.523 0"/>
  </joint>

  <!-- ==================== CAMERA REAR ====================
       Faces backward (-X), tilted down ~20° to see shelf-face ArUco markers
       during reverse docking. Yaw=π flips the camera 180°; pitch=+0.349
       produces a downward look in world frame (tilt direction inverts with yaw).
       Topic: /camera/rear/image_raw
  -->
  <link name="camera_link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.03"/>
  </link>

  <joint name="camera_joint_2" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link_2"/>
    <!-- Rear face of robot (x=-0.175), yaw=π faces backward, pitch=+0.349 tilts down ~20° -->
    <origin xyz="-0.175 0 0.04" rpy="0 0.349 3.14159"/>
  </joint>

<gazebo>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>front_left_wheel_joint</left_joint>
    <left_joint>rear_left_wheel_joint</left_joint>
    <right_joint>front_right_wheel_joint</right_joint>
    <right_joint>rear_right_wheel_joint</right_joint>
    <wheel_separation>0.28</wheel_separation>
    <wheel_radius>0.05</wheel_radius>
    <topic>/model/my_robot/cmd_vel</topic>
    <odom_publish_frequency>0</odom_publish_frequency>
    <odom_topic>/model/my_robot/diff_drive_unused_odom</odom_topic>
    <tf_topic>/model/my_robot/diff_drive_unused_tf</tf_topic>
  </plugin>
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <odom_frame>odom</odom_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
    <odom_topic>/model/my_robot/odometry</odom_topic>
    <odom_publish_frequency>20</odom_publish_frequency>
    <dimensions>2</dimensions>
  </plugin>
  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <update_rate>20</update_rate>
    <topic>/joint_states</topic>
    <joint_name>front_left_wheel_joint</joint_name>
    <joint_name>front_right_wheel_joint</joint_name>
    <joint_name>rear_left_wheel_joint</joint_name>
    <joint_name>rear_right_wheel_joint</joint_name>
  </plugin>
</gazebo>

<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <topic>/scan</topic>
    <update_rate>10</update_rate>
    <gz_frame_id>lidar_link</gz_frame_id>
    <frame_id>lidar_link</frame_id>
    <ignition_frame_id>lidar_link</ignition_frame_id>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.25</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="base_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <topic>/imu</topic>
    <gz_frame_id>base_link</gz_frame_id>
    <frame_id>base_link</frame_id>
    <ignition_frame_id>base_link</ignition_frame_id>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="camera_link_1">
  <sensor name="camera_front" type="camera">
    <topic>/camera/front/image_raw</topic>
    <gz_frame_id>camera_link_1</gz_frame_id>
    <frame_id>camera_link_1</frame_id>
    <ignition_frame_id>camera_link_1</ignition_frame_id>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<gazebo reference="camera_link_2">
  <sensor name="camera_rear" type="camera">
    <topic>/camera/rear/image_raw</topic>
    <gz_frame_id>camera_link_2</gz_frame_id>
    <frame_id>camera_link_2</frame_id>
    <ignition_frame_id>camera_link_2</ignition_frame_id>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

</robot>
