[MASTER]
# ROS 2 message/service Python modules only resolve inside a sourced
# environment; CI and local shells may differ, so import errors are the
# linter's problem, not the code's (ruff F401/colcon cover imports).
ignore-paths=
    build,
    install,
    log

[MESSAGES CONTROL]
disable=
    import-error,
    no-member,
    too-few-public-methods,
    duplicate-code,
    fixme,
    # Import order/layout is the authority of ament_flake8 (google style,
    # enforced by colcon test) — pylint's grouping rules contradict it.
    wrong-import-order,
    wrong-import-position,
    ungrouped-imports,
    # mission_node sets DDS env vars before importing rclpy — intentional.
    # ruff is the authority for style; pylint stays on semantics
    line-too-long,
    missing-docstring

[BASIC]
# ROS naming: nodes/classes often use snake_case class names
good-names=i,j,k,n,x,y,z,q,rc,cb,msg,tb,_

[TYPECHECK]
# ROS message classes are generated at build time; pylint cannot introspect
ignored-modules=
    rclpy,
    action_msgs,
    builtin_interfaces,
    geometry_msgs,
    nav2_msgs,
    nav_msgs,
    ros_gz_interfaces,
    std_msgs,
    std_srvs,
    tf2_ros,
    trajectory_msgs

[DESIGN]
# ROS nodes legitimately accumulate many pubs/subs/clients/params.
max-attributes=20
# The mission state machine dispatcher (_poll) branches per phase.
max-branches=20

[FORMAT]
max-line-length=99

[REPORTS]
score=no
output-format=colorized
